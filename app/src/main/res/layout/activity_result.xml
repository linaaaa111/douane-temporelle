<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_root_ya"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/color_accepted">

    <TextView
        android:id="@+id/tv_titre_resultat_ya"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VERDICT DU TEMPS"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/color_text"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/tv_message_ya"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Message"
        android:textSize="18sp"
        android:textColor="@color/color_text"
        android:gravity="center"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/btn_nouveau_voyageur_ya"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nouveau voyageur"
        android:backgroundTint="@color/color_text"
        android:textColor="#000000" />

</LinearLayout>