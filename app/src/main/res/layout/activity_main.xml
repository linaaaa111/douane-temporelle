<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView
        android:id="@+id/tv_titre_nj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Douane Temporelle"
        android:textSize="26sp"
        android:textStyle="bold" />
    <EditText
    android:id="@+id/et_nom_nj"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="Nom du voyageur"
    android:inputType="textPersonName" />
    <EditText
        android:id="@+id/et_naissance_nj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Année de naissance (ex : 1990)"
        android:inputType="number"
        android:maxLength="4" />

    <EditText
        android:id="@+id/et_destination_nj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Année de destination (ex : 2050)"
        android:inputType="number"
        android:maxLength="4" />
    <Spinner
        android:id="@+id/sp_motif_nj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/motifs" />
    <Button
        android:id="@+id/btn_inspecter_nj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Inspecter le profil" />
</LinearLayout>

