
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Titre -->
        <TextView
            android:id="@+id/tv_titre_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DOUANE TEMPORELLE"
            android:textColor="#172554"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FORMULAIRE D'ENREGISTREMENT"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Nom -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nom du voyageur"
            android:textColor="#334155"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_nom_nj"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Entrez votre nom"
            android:inputType="textPersonName"
            android:padding="14dp"
            android:textSize="15sp"
            android:backgroundTint="#94A3B8"
            android:layout_marginBottom="20dp" />

        <!-- Année de naissance -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Année de naissance"
            android:textColor="#334155"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_naissance_nj"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Exemple : 1990"
            android:inputType="number"
            android:maxLength="4"
            android:padding="14dp"
            android:textSize="15sp"
            android:backgroundTint="#94A3B8"
            android:layout_marginBottom="20dp" />

        <!-- Année de destination -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Année de destination"
            android:textColor="#334155"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_destination_nj"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Exemple : 2050"
            android:inputType="number"
            android:maxLength="4"
            android:padding="14dp"
            android:textSize="15sp"
            android:backgroundTint="#94A3B8"
            android:layout_marginBottom="20dp" />

        <!-- Motif -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motif du voyage"
            android:textColor="#334155"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/sp_motif_nj"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:entries="@array/motifs"
            android:backgroundTint="#94A3B8"
            android:layout_marginBottom="32dp" />

        <!-- Bouton -->
        <Button
            android:id="@+id/btn_inspecter_nj"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="INSPECTER LE PROFIL"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:backgroundTint="#2563EB" />


    </LinearLayout>

</ScrollView>
