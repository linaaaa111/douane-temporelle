
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F1F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_titre_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="DOUANE TEMPORELLE"
            android:fontFamily="sans-serif-condensed"
            android:textColor="#172554"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />lina

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="FORMULAIRE D'ENREGISTREMENT"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Nom du voyageur"
            android:textColor="#1E3A5F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_nom_nj"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_input_nj"
            android:hint="Entrez votre nom"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:textColor="#172554"
            android:textColorHint="#94A3B8"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Année de naissance"
            android:textColor="#1E3A5F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_naissance_nj"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_input_nj"
            android:hint="Exemple : 1990"
            android:inputType="number"
            android:maxLength="4"
            android:padding="12dp"
            android:textColor="#172554"
            android:textColorHint="#94A3B8"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Année de destination"
            android:textColor="#1E3A5F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_destination_nj"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_input_nj"
            android:hint="Exemple : 2050"
            android:inputType="number"
            android:maxLength="4"
            android:padding="12dp"
            android:textColor="#172554"
            android:textColorHint="#94A3B8"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Motif du voyage"
            android:textColor="#1E3A5F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sp_motif_nj"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/bg_input_nj"
            android:entries="@array/motifs"
            android:padding="8dp" />

        <Button
            android:id="@+id/btn_inspecter_nj"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_button_nj"
            android:elevation="5dp"
            android:text="INSPECTER LE PROFIL  →"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

    </LinearLayout>
</ScrollView>
