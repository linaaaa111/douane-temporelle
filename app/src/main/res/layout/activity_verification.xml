<?xml version="1.0" encoding="utf-8"?>
<!--  el LinearLayout principal horizontal  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:weightSum="1"
    android:background="#F1F5F9">

    <!-- 3al lisar: taswira tekhou poids 0.3 -->
    <ImageView
        android:id="@+id/iv_photo_wb"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:background="#172554"
        android:contentDescription="Photo du voyageur"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_voyageur" />

    <!--  3al imin: RelativeLayout b poids 0.7 lel textes wel boutons -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:padding="16dp">

        <!-- el titre yet7at fou9 -->
        <TextView
            android:id="@+id/tv_entete_wb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#172554"
            android:gravity="center"
            android:padding="14dp"
            android:text="PASSEPORT TEMPOREL"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- bouton REFUSER yet7at louta fel ecran -->
        <Button
            android:id="@+id/btn_refuser_wb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:backgroundTint="#DC2626"
            android:text="REFUSER (RISQUE DE PARADOXE)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!--  bouton APPROUVER yet7at fou9 bouton REFUSER direct -->
        <Button
            android:id="@+id/btn_approuver_wb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/btn_refuser_wb"
            android:backgroundTint="#2563EB"
            android:text="APPROUVER LE SAUT TEMPOREL"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!--  carte mta3 ma3loumet el voyageur tkoun bin el titre wel boutons -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/btn_approuver_wb"
            android:layout_below="@id/tv_entete_wb">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_nom_wb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#334155"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_age_wb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#334155"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_motif_wb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#334155"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_trajet_wb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#334155"
                    android:textSize="16sp" />
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</LinearLayout>